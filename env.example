# Database Configuration
# Option 1: Docker PostgreSQL (default)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_content_db

# Option 2: Local PostgreSQL (uncomment and update if using local PostgreSQL)
# DATABASE_URL=postgresql+psycopg2://your_username:your_password@localhost:5432/ai_content_db

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MCP Server URLs
MCP_TAVILY_URL=https://server.smithery.ai/@Jeetanshu18/tavily-mcp/mcp
MCP_FLUX_URL=https://server.smithery.ai/@falahgs/flux-imagegen-mcp-server/mcp


MCP_TAVILY_API_KEY=https://server.smithery.ai/@Jeetanshu18/tavily-mcp/mcp

 
# App Settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1 